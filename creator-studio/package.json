{
  "name": "creator-studio-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Creator Studio AI - mobile-first AI YouTube production studio (PWA)",
  "scripts": {
    "dev": "node scripts/build-sw.mjs && next dev",
    "build": "node scripts/build-sw.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "postinstall": "node scripts/copy-ffmpeg-core.mjs",
    "worker": "node --experimental-strip-types render-worker/server.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.75.0",
    "mediabunny": "^1.66.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "type": "module"
}