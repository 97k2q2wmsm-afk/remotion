# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.
# Keys set here stay on the server and are never sent to the browser. All are optional:
# you can also enter keys per device in the app (Settings → AI providers).

# Protects this server's AI proxy so only you can use it. Enter the same value in Settings → Security.
APP_ACCESS_TOKEN=

# Text / script AI (free tiers)
GEMINI_API_KEY=          # also used for Gemini TTS
HF_TOKEN=                # Hugging Face: text, FLUX images, MMS TTS (monthly free credits)
GROQ_API_KEY=
OPENROUTER_API_KEY=      # keep ":free" model ids to stay free
POLLINATIONS_TOKEN=      # optional; anonymous use works with rate limits

# Images
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
TOGETHER_API_KEY=        # paid — the app asks before every batch

# Voice
ELEVENLABS_API_KEY=

# Paid text model — the app asks before every request
ANTHROPIC_API_KEY=
