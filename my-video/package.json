{
  "name": "la-voz-del-legado",
  "version": "1.0.0",
  "description": "La Voz del Legado — motor de YouTube Shorts históricos con Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "private": true,
  "dependencies": {
    "@motion-canvas/core": "^3.17.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/bundler": "4.0.545",
    "@remotion/captions": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/fonts": "4.0.545",
    "@remotion/media-utils": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@remotion/three": "4.0.545",
    "@remotion/transitions": "4.0.545",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.545",
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "story:timeline": "node scripts/prepare.mjs",
    "story:score": "node scripts/score.mjs",
    "pompeya:build": "node scripts/prepare.mjs pompeya && node scripts/score.mjs pompeya",
    "pompeya:render": "remotion render Pompeya out/pompeya_ultimo_dia.mp4 --codec=h264 --crf=18 --audio-bitrate=320k",
    "bg:new": "node scripts/bg-new.mjs",
    "bg:episode": "node scripts/bg-episode.mjs",
    "bg:score": "node scripts/bg-score.mjs",
    "bg:master": "node scripts/bg-master.mjs",
    "yercekimi:render": "node scripts/bg-episode.mjs yercekimi",
    "studio": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON studio/server.mjs",
    "studio:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'studio/test/*.test.mjs'"
  },
  "allowScripts": {
    "esbuild": false
  }
}
