{
  "name": "la-voz-del-legado",
  "version": "1.0.0",
  "description": "La Voz del Legado — motor de YouTube Shorts históricos con Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/captions": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/fonts": "4.0.545",
    "@remotion/media-utils": "4.0.545",
    "@remotion/transitions": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.545",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "story:timeline": "node scripts/prepare.mjs",
    "story:score": "node scripts/score.mjs",
    "pompeya:build": "node scripts/prepare.mjs pompeya && node scripts/score.mjs pompeya",
    "pompeya:render": "remotion render Pompeya out/pompeya_ultimo_dia.mp4 --codec=h264 --crf=18 --audio-bitrate=320k"
