# Cinematic AI Studio — copy to .env (read by `npm run studio`) and adjust.
# Everything is optional; with nothing set the studio runs fully offline and free.

# ── Server ─────────────────────────────────────────────────────────────────────
STUDIO_PORT=4555
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from your phone on the LAN.
STUDIO_HOST=127.0.0.1
# Required for off-device access when STUDIO_HOST=0.0.0.0 (open http://<ip>:4555/?token=...)
STUDIO_TOKEN=
# Where projects, renders and exports are stored (default: ./studio-data)
STUDIO_DATA_DIR=

# ── Rendering ──────────────────────────────────────────────────────────────────
# Chromium WebGL backend for Remotion: angle | swangle | egl | vulkan | angle-egl
RENDER_GL=angle
# Parallel render tabs (default: 1 without a GPU, more with one)
RENDER_CONCURRENCY=

# ── ComfyUI (free, local or on another machine) ───────────────────────────────
COMFYUI_ENABLED=true
COMFYUI_URL=http://127.0.0.1:8188
# Exact filenames inside ComfyUI/models/... — the studio never downloads weights.
COMFYUI_IMAGE_CHECKPOINT=
WAN22_VARIANT=ti2v_5b
WAN22_UNET=wan2.2_ti2v_5B_fp16.safetensors
WAN22_TEXT_ENCODER=umt5_xxl_fp8_e4m3fn_scaled.safetensors
WAN22_VAE=wan2.2_vae.safetensors
WAN22_UNET_HIGH=wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors
WAN22_UNET_LOW=wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors
LTX_CHECKPOINT=ltx-video-2b-v0.9.5.safetensors
LTX_TEXT_ENCODER=t5xxl_fp16.safetensors

# ── AUTOMATIC1111 / Forge (free, local) ───────────────────────────────────────
A1111_ENABLED=false
A1111_URL=http://127.0.0.1:7860

# ── Official repositories via CLI (free, local) ───────────────────────────────
WAN22_REPO=
WAN22_CKPT_DIR=
LTX_REPO=

# ── Blender (optional) ────────────────────────────────────────────────────────
BLENDER_PATH=
BLENDER_ENGINE=CYCLES

# ── Speech ────────────────────────────────────────────────────────────────────
# auto | piper | espeak | google | none
TTS_PROVIDER=auto
PIPER_BINARY=piper
PIPER_MODEL=
# PAID: only used if also enabled + consented in Settings.
GOOGLE_TTS_API_KEY=

# ── Script writer ─────────────────────────────────────────────────────────────
# template | ollama
LLM_PROVIDER=template
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
